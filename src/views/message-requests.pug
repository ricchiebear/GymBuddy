extends layout

block content
    main.message-requests-page
        h1 Message Requests

        if requests && requests.length > 0
            each request in requests
                article.message-request-card
                    .request-sender
                        if request.sender_profile_picture
                            img(
                                src=request.sender_profile_picture
                                alt=`${request.sender_first_name} ${request.sender_last_name}`
                                width="50"
                                height="50"
                            )
                        else
                            span 👤

                        h2
                            | #{request.sender_first_name} #{request.sender_last_name}

                    p
                        strong Message:
                        |  #{request.first_message}

                    small= new Date(request.created_at).toLocaleString("en-GB", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })

                    .request-actions
                        form(
                            method="POST"
                            action=`/message-requests/${request.request_id}/accept`
                        )
                            button(type="submit") Accept

                        form(
                            method="POST"
                            action=`/message-requests/${request.request_id}/reject`
                        )
                            button(type="submit") Reject
        else
            p You have no pending message requests.