doctype html

html
    head
        meta(charset="UTF-8")
        meta(
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        )

        title= title ? `${title} | GymBuddy` : "GymBuddy"

        link(
            rel="stylesheet"
            href="/css/style.css"
        )

    body

        //=====================================================
        // MAIN NAVIGATION
        //=====================================================

        nav.main-navigation

            // Home is available to everyone
            a(
                href="/"
            ) 🏠 Home



            if isLoggedIn


                a(
                    href="/workouts"
                ) 🏋️ Workouts


                a(
                    href="/recommendations"
                ) 🤝 Recommendations


                a(
                |   href="/ai-coach"
                ) 🤖 AI Coach    


                a(
                    href="/messages"
                ) 💬 Messages


                a(
                    href="/notifications"
                ) 🔔 Notifications


                a(
                    href="/profile"
                ) 👤 My Profile


                a(
                    href="/logout"
                ) Logout


            else


                a(
                    href="/register"
                ) Register

    
                a(
                    href="/login"
                ) Login

        //=====================================================
        // PAGE CONTENT
        //=====================================================

        main
            block content