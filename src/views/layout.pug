doctype html

html

    head

        meta(
            charset="UTF-8"
        )

        meta(
            name="viewport"
            content="width=device-width, initial-scale=1.0"
        )

        title= title ? `${title} | GymBuddy` : "GymBuddy"

        link(
            rel="stylesheet"
            href="/css/style.css"
        )


    body

        //=====================================================
        // MAIN NAVIGATION
        //=====================================================

        header.site-header

            nav.main-navigation

                //=================================================
                // BRAND
                //=================================================

                a.brand(
                    href="/"
                )

                    span.brand-icon
                        | 🏋️

                    span.brand-name
                        | GymBuddy


                //=================================================
                // NAVIGATION LINKS
                //=================================================

                .navigation-links

                    a.nav-link(
                        href="/"
                    )

                        span.nav-icon
                            | 🏠

                        span
                            | Home


                    if isLoggedIn

                        a.nav-link(
                            href="/workouts"
                        )

                            span.nav-icon
                                | 🏋️

                            span
                                | Workouts


                        a.nav-link(
                            href="/recommendations"
                        )

                            span.nav-icon
                                | 🤝

                            span
                                | Recommendations


                        a.nav-link(
                            href="/ai-coach"
                        )

                            span.nav-icon
                                | 🤖

                            span
                                | AI Coach


                        a.nav-link(
                            href="/messages"
                        )

                            span.nav-icon
                                | 💬

                            span
                                | Messages


                        a.nav-link(
                            href="/notifications"
                        )

                            span.nav-icon
                                | 🔔

                            span
                                | Notifications


                //=================================================
                // ACCOUNT AREA
                //=================================================

                .navigation-account

                    if isLoggedIn

                        a.profile-nav-link(
                            href="/profile"
                        )

                            span.profile-nav-icon
                                | 👤

                            span
                                | My Profile


                        form.logout-form(
                            action="/logout"
                            method="POST"
                        )

                            button.logout-button(
                                type="submit"
                            )
                                | Logout


                    else

                        a.register-nav-link(
                            href="/register"
                        )
                            | Register


                        a.login-nav-link(
                            href="/login"
                        )
                            | Login


        //=====================================================
        // GLOBAL USER FEEDBACK
        //=====================================================

        if feedback

            section(
                class=`app-feedback app-feedback-${feedback.type || "info"}`
                role="alert"
            )

                .app-feedback-icon

                    if feedback.type === "success"
                        | ✓

                    else if feedback.type === "error"
                        | !

                    else if feedback.type === "warning"
                        | ⚠

                    else
                        | i


                .app-feedback-content

                    strong

                        if feedback.type === "success"
                            | Success

                        else if feedback.type === "error"
                            | Error

                        else if feedback.type === "warning"
                            | Heads up

                        else
                            | Information


                    p
                        = feedback.message


        //=====================================================
        // PAGE CONTENT
        //=====================================================

        main.site-main

            block content


        //=====================================================
        // FOOTER
        //=====================================================

        footer.site-footer

            .footer-content

                p
                    | © 2026 GymBuddy


                .footer-links

                    a(
                        href="/support"
                    )
                        | Help & Support