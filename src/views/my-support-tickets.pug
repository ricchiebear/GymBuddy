extends layout

block content

    main.my-support-tickets-page

        // =====================================================
        // PAGE HERO
        // =====================================================

        section.my-tickets-hero

            .my-tickets-hero-content

                .my-tickets-hero-icon
                    | 🎫

                .my-tickets-hero-text

                    p.my-tickets-eyebrow
                        | SUPPORT CENTRE

                    h1 My Support Tickets

                    p
                        | Track your support requests and view
                        | the details of issues you have reported.


            .my-tickets-hero-actions

                a.my-tickets-primary-button(
                    href="/support"
                )
                    | + New Support Ticket


        // =====================================================
        // TICKET SUMMARY
        // =====================================================

        section.my-tickets-summary

            .my-ticket-summary-card

                .my-ticket-summary-icon
                    | 🎫

                .my-ticket-summary-content

                    span.my-ticket-summary-number
                        if tickets
                            = tickets.length
                        else
                            | 0

                    span.my-ticket-summary-label
                        | Total Tickets


            .my-ticket-summary-card

                .my-ticket-summary-icon
                    | ⏳

                .my-ticket-summary-content

                    span.my-ticket-summary-number
                        if tickets
                            - const openTickets = tickets.filter(function(ticket) { return String(ticket.status || "").toLowerCase() !== "resolved" && String(ticket.status || "").toLowerCase() !== "closed"; }).length
                            = openTickets
                        else
                            | 0

                    span.my-ticket-summary-label
                        | Active Tickets


            .my-ticket-summary-card

                .my-ticket-summary-icon
                    | ✓

                .my-ticket-summary-content

                    span.my-ticket-summary-number
                        if tickets
                            - const resolvedTickets = tickets.filter(function(ticket) { return String(ticket.status || "").toLowerCase() === "resolved" || String(ticket.status || "").toLowerCase() === "closed"; }).length
                            = resolvedTickets
                        else
                            | 0

                    span.my-ticket-summary-label
                        | Resolved


        // =====================================================
        // SECTION HEADER
        // =====================================================

        section.my-tickets-section-header

            .my-tickets-section-title

                p.my-tickets-eyebrow
                    | YOUR REQUESTS

                h2 Support History

                p
                    | View the status and details of your
                    | previous GymBuddy support requests.


        // =====================================================
        // TICKET LIST / EMPTY STATE
        // =====================================================

        if tickets && tickets.length > 0

            section.my-tickets-list

                each ticket in tickets

                    - const ticketStatus = String(ticket.status || "open").toLowerCase()

                    article.my-ticket-card

                        // =====================================
                        // TICKET ICON
                        // =====================================

                        .my-ticket-card-icon

                            if ticketStatus === "resolved" || ticketStatus === "closed"

                                | ✓

                            else if ticketStatus === "pending"

                                | ⏳

                            else

                                | 🎫


                        // =====================================
                        // TICKET INFORMATION
                        // =====================================

                        .my-ticket-card-content

                            .my-ticket-card-heading

                                .my-ticket-card-title

                                    span.my-ticket-number
                                        | Ticket ##{ticket.ticket_id}

                                    h3
                                        = ticket.issue_type || "Support Request"


                                span.my-ticket-status(
                                    class=`ticket-status-${ticketStatus}`
                                )
                                    = ticket.status || "Open"


                            // =================================
                            // MESSAGE PREVIEW
                            // =================================

                            if ticket.message

                                p.my-ticket-preview
                                    = ticket.message


                            // =================================
                            // TICKET META INFORMATION
                            // =================================

                            .my-ticket-meta

                                if ticket.created_at

                                    span.my-ticket-meta-item

                                        span.my-ticket-meta-icon
                                            | 🕒

                                        span
                                            | Submitted #{new Date(ticket.created_at).toLocaleString("en-GB", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" })}


                                if ticket.email

                                    span.my-ticket-meta-item

                                        span.my-ticket-meta-icon
                                            | ✉️

                                        span
                                            = ticket.email


                        // =====================================
                        // VIEW TICKET
                        // =====================================

                        .my-ticket-card-action

                            a.my-ticket-view-button(
                                href=`/support-tickets/${ticket.ticket_id}`
                            )
                                | View Details →


        else

            section.my-tickets-empty

                .my-tickets-empty-icon
                    | 🎫

                h2 No support tickets yet

                p
                    | You haven't submitted any support requests yet.
                    | If you're experiencing a problem with GymBuddy,
                    | you can contact support and we'll keep your
                    | request here for you to track.

                a.my-tickets-empty-button(
                    href="/support"
                )
                    | Contact Support