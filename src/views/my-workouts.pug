extends layout

block content

    main.my-workouts-page

        // =====================================================
        // PAGE HERO
        // =====================================================

        section.my-workouts-hero

            .my-workouts-hero-copy

                p.my-workouts-eyebrow
                    | WORKOUT MANAGEMENT

                h1 My Workouts

                p
                    | Manage the sessions you've created,
                    | track participation and keep each workout
                    | up to date.


            .my-workouts-hero-actions

                .my-workouts-summary

                    .my-workouts-summary-icon
                        | 🏋️

                    div

                        small
                            | Created Workouts

                        strong
                            if workouts
                                = workouts.length
                            else
                                | 0


                a.my-workouts-create-button(
                    href="/workouts/create"
                )
                    | + Create Workout


        // =====================================================
        // WORKOUT CONTENT
        // =====================================================

        if !workouts || workouts.length === 0

            section.my-workouts-empty

                .my-workouts-empty-icon
                    | 🏋️

                h2 No workouts created yet

                p
                    | Create your first workout and start
                    | connecting with other GymBuddy users.

                a.primary-button(
                    href="/workouts/create"
                )
                    | Create Workout

        else

            section.my-workouts-grid

                each workout in workouts

                    - const workoutStatus = String(workout.status || "").toLowerCase()

                    article.my-workout-card

                        // =========================================
                        // WORKOUT IMAGE
                        // =========================================

                        .my-workout-image

                            if workout.workout_image

                                img(
                                    src=workout.workout_image
                                    alt=workout.title
                                )

                            else

                                .my-workout-image-placeholder
                                    | 🏋️


                            span.my-workout-status(
                                class=`my-workout-status-${workoutStatus}`
                            )
                                = workout.status || "Unknown"


                        // =========================================
                        // WORKOUT CONTENT
                        // =========================================

                        .my-workout-content

                            .my-workout-topline

                                span.my-workout-type
                                    = workout.workout_type || "Workout"

                                span.my-workout-participants
                                    | 👥 #{workout.participants_count || 0}


                            h2
                                = workout.title


                            // =====================================
                            // WORKOUT INFORMATION
                            // =====================================

                            .my-workout-details

                                .my-workout-detail

                                    span
                                        | 📍

                                    div

                                        small
                                            | Location

                                        strong
                                            = workout.location || "Not set"


                                .my-workout-detail

                                    span
                                        | 🕒

                                    div

                                        small
                                            | Starts

                                        if workout.start_time

                                            strong
                                                = new Date(workout.start_time).toLocaleString("en-GB")

                                        else

                                            strong
                                                | Not set


                                .my-workout-detail

                                    span
                                        | ⏱️

                                    div

                                        small
                                            | Ends

                                        if workout.end_time

                                            strong
                                                = new Date(workout.end_time).toLocaleString("en-GB")

                                        else

                                            strong
                                                | Not set


                            // =====================================
                            // MAIN ACTIONS
                            // =====================================

                            .my-workout-primary-actions

                                a.my-workout-view-button(
                                    href=`/workouts/${workout.workout_id}`
                                )
                                    | View Details


                                a.my-workout-chat-button(
                                    href=`/workouts/${workout.workout_id}/chat`
                                )
                                    | 💬 Group Chat


                            // =====================================
                            // OPEN WORKOUT MANAGEMENT
                            // =====================================

                            if workoutStatus === "open"

                                .my-workout-management

                                    a.my-workout-edit-button(
                                        href=`/workouts/${workout.workout_id}/edit`
                                    )
                                        | ✏️ Edit


                                    form(
                                        method="POST"
                                        action=`/workouts/${workout.workout_id}/complete`
                                        onsubmit="return confirm('Mark this workout as completed? This will update workout history and streaks for the owner and all accepted participants.')"
                                    )

                                        button.my-workout-complete-button(
                                            type="submit"
                                        )
                                            | ✓ Complete


                                    form(
                                        method="POST"
                                        action=`/workouts/${workout.workout_id}/cancel`
                                        onsubmit="return confirm('Are you sure you want to cancel this workout? All accepted participants will be notified.')"
                                    )

                                        button.my-workout-cancel-button(
                                            type="submit"
                                        )
                                            | Cancel


                            // =====================================
                            // CANCELLED WORKOUT
                            // =====================================

                            if workoutStatus === "cancelled"

                                .my-workout-state-message

                                    span
                                        | 🚫

                                    p
                                        | This workout has been cancelled.


                            // =====================================
                            // COMPLETED WORKOUT
                            // =====================================

                            if workoutStatus === "completed"

                                .my-workout-state-message

                                    span
                                        | ✓

                                    p
                                        | This workout has been completed.


                            // =====================================
                            // DELETE WORKOUT
                            // =====================================

                            .my-workout-danger-zone

                                form(
                                    method="POST"
                                    action=`/workouts/${workout.workout_id}/delete`
                                    onsubmit="return confirm('Are you sure you want to permanently delete this workout? This action cannot be undone.')"
                                )

                                    button.my-workout-delete-button(
                                        type="submit"
                                    )
                                        | Delete Workout