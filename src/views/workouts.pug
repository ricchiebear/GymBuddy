extends layout

block content

    main.workouts-page

        // =====================================================
        // PAGE HEADER
        // =====================================================

        section.workouts-header

            .workouts-header-content

                p.workouts-eyebrow
                    | DISCOVER WORKOUTS

                h1 Find Your Next Workout

                p.workouts-subtitle
                    | Browse available workouts, find sessions that match
                    | your goals and connect with other GymBuddy users.

            a.workouts-create-button(
                href="/workouts/create"
            )
                | + Create Workout


        // =====================================================
        // FILTER SECTION
        // =====================================================

        section.workout-filter-card

            .workout-filter-heading

                h2 Find a Workout

                p
                    | Search by workout type, location or status.


            form.workout-filter-form(
                method="GET"
                action="/workouts"
            )

                .workout-filter-field

                    label(
                        for="type"
                    )
                        | Workout Type

                    input(
                        type="text"
                        id="type"
                        name="type"
                        placeholder="e.g. Running, Strength, Football"
                        value=filters && filters.type ? filters.type : ""
                    )


                .workout-filter-field

                    label(
                        for="location"
                    )
                        | Location

                    input(
                        type="text"
                        id="location"
                        name="location"
                        placeholder="e.g. London, Hackney"
                        value=filters && filters.location ? filters.location : ""
                    )


                .workout-filter-field

                    label(
                        for="status"
                    )
                        | Status

                    select(
                        id="status"
                        name="status"
                    )

                        option(
                            value=""
                            selected=!filters || !filters.status
                        )
                            | All Statuses

                        option(
                            value="Open"
                            selected=filters && filters.status === "Open"
                        )
                            | Open

                        option(
                            value="Cancelled"
                            selected=filters && filters.status === "Cancelled"
                        )
                            | Cancelled

                        option(
                            value="Completed"
                            selected=filters && filters.status === "Completed"
                        )
                            | Completed


                .workout-filter-actions

                    button.workout-search-button(
                        type="submit"
                    )
                        | Search

                    a.workout-clear-button(
                        href="/workouts"
                    )
                        | Clear


        // =====================================================
        // RESULTS
        // =====================================================

        section.workout-results-section

            .workout-results-header

                div

                    p.workouts-eyebrow
                        | AVAILABLE SESSIONS

                    h2 Workouts

                if workouts && workouts.length > 0

                    span.workout-result-count
                        | #{workouts.length} workout#{workouts.length === 1 ? "" : "s"} found


            if !workouts || workouts.length === 0

                section.workout-empty-state

                    .workout-empty-icon
                        | 🏋️

                    h2 No workouts found

                    p
                        | We couldn't find any workouts matching
                        | your current filters.

                    .workout-empty-actions

                        a.workout-empty-primary(
                            href="/workouts"
                        )
                            | Clear Filters

                        a.workout-empty-secondary(
                            href="/workouts/create"
                        )
                            | Create Workout

            else

                section.workout-discovery-grid

                    each workout in workouts

                        - const workoutStatus = String(workout.status || "").toLowerCase()
                        - const startDate = workout.start_time ? new Date(workout.start_time) : null
                        - const endDate = workout.end_time ? new Date(workout.end_time) : null
                        - const createdDate = workout.created_at ? new Date(workout.created_at) : null
                        - const formattedDate = startDate ? startDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }) : "Not available"
                        - const formattedStartTime = startDate ? startDate.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" }) : "Not available"
                        - const formattedEndTime = endDate ? endDate.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" }) : null
                        - const formattedCreatedDate = createdDate ? createdDate.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }) : null

                        article.workout-discovery-card

                            // =====================================
                            // IMAGE
                            // =====================================

                            .workout-card-image

                                if workout.workout_image

                                    img(
                                        src=workout.workout_image
                                        alt=workout.title
                                    )

                                else

                                    .workout-image-placeholder

                                        span
                                            | 🏋️


                                if workout.status

                                    span.workout-status-badge(
                                        class=`workout-status-${workoutStatus}`
                                    )
                                        = workout.status


                            // =====================================
                            // BODY
                            // =====================================

                            .workout-card-body

                                if workout.workout_type

                                    span.workout-type-badge
                                        = workout.workout_type


                                h2.workout-card-title
                                    = workout.title


                                .workout-card-details

                                    // LOCATION

                                    .workout-card-detail

                                        span.workout-detail-icon
                                            | 📍

                                        div

                                            small
                                                | Location

                                            strong
                                                = workout.location || "Not specified"


                                    // DATE

                                    .workout-card-detail

                                        span.workout-detail-icon
                                            | 📅

                                        div

                                            small
                                                | Date

                                            strong
                                                = formattedDate


                                    // TIME

                                    .workout-card-detail

                                        span.workout-detail-icon
                                            | 🕐

                                        div

                                            small
                                                | Time

                                            strong
                                                if formattedEndTime
                                                    | #{formattedStartTime} – #{formattedEndTime}
                                                else
                                                    = formattedStartTime


                                    // PARTICIPANTS

                                    .workout-card-detail

                                        span.workout-detail-icon
                                            | 👥

                                        div

                                            small
                                                | Participants

                                            strong
                                                = workout.participants_count || 0


                            // =====================================
                            // FOOTER
                            // =====================================

                            .workout-card-footer

                                if formattedCreatedDate

                                    small.workout-created-date
                                        | Created #{formattedCreatedDate}


                                a.workout-details-button(
                                    href=`/workouts/${workout.workout_id}`
                                )
                                    | View Details →