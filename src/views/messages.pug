extends layout

block content
    main.messages-page
        h1 Messages

        if pendingRequestCount > 0
            p
                a(href="/message-requests")
                    | You have #{pendingRequestCount} pending message request#{pendingRequestCount === 1 ? "" : "s"}

        h2 Conversations

        if conversations && conversations.length > 0
            each conversation in conversations
                .conversation-card
                    if conversation.partner_profile_picture
                        img(
                            src=conversation.partner_profile_picture
                            alt=`${conversation.partner_first_name} ${conversation.partner_last_name}`
                            width="50"
                            height="50"
                        )
                    else
                        span 👤

                    .conversation-details
                        h3
                            a(href=`/messages/${conversation.partner_id}`)
                                | #{conversation.partner_first_name} #{conversation.partner_last_name}

                        p= conversation.message

                        small= new Date(conversation.created_at).toLocaleString("en-GB", { day: "2-digit", month: "short", hour: "2-digit", minute: "2-digit" })
        else
            p You do not have any conversations yet.

        h2 Start a Conversation

        if users && users.length > 0
            each user in users
                .user-card
                    if user.profile_picture
                        img(
                            src=user.profile_picture
                            alt=`${user.first_name} ${user.last_name}`
                            width="45"
                            height="45"
                        )
                    else
                        span 👤

                    a(href=`/messages/${user.user_id}`)
                        | #{user.first_name} #{user.last_name}
        else
            p No other users are available.