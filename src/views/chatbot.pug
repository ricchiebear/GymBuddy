extends layout

block content

    main.ai-coach-page

        // =====================================================
        // AI COACH HEADER
        // =====================================================

        section.ai-coach-header

            .ai-coach-header-content

                .ai-coach-main-icon
                    | 🤖

                .ai-coach-title-text

                    p.ai-coach-eyebrow
                        | PERSONAL FITNESS ASSISTANT

                    h1 GymBuddy AI Coach

                    p
                        | Get personalised guidance based on your
                        | workouts, progress and fitness journey.


            form(
                method="POST"
                action="/ai-coach/new"
            )

                button.ai-new-chat-button(
                    type="submit"
                )
                    span
                        | +

                    | New Chat


        // =====================================================
        // AI CHAT APPLICATION
        // =====================================================

        section.ai-chat-layout

            // =================================================
            // CONVERSATION SIDEBAR
            // =================================================

            aside.ai-chat-sidebar

                .ai-sidebar-heading

                    div

                        p.ai-sidebar-eyebrow
                            | CHAT HISTORY

                        h2 Conversations

                    span.ai-conversation-count
                        if conversations
                            = conversations.length
                        else
                            | 0


                .ai-conversation-list

                    if conversations && conversations.length > 0

                        each conversation in conversations

                            if Number(conversation.conversation_id) === Number(activeConversationId)

                                a.ai-conversation-item.ai-conversation-active(
                                    href=`/ai-coach/conversations/${conversation.conversation_id}`
                                )

                                    .ai-conversation-icon
                                        | 💬

                                    .ai-conversation-details

                                        strong
                                            = conversation.title || "Untitled Conversation"

                                        span
                                            | Current chat


                                    span.ai-active-indicator


                            if Number(conversation.conversation_id) !== Number(activeConversationId)

                                a.ai-conversation-item(
                                    href=`/ai-coach/conversations/${conversation.conversation_id}`
                                )

                                    .ai-conversation-icon
                                        | 💬

                                    .ai-conversation-details

                                        strong
                                            = conversation.title || "Untitled Conversation"

                                        span
                                            | Open conversation


                    else

                        .ai-no-conversations

                            .ai-no-conversations-icon
                                | 💬

                            strong
                                | No chats yet

                            p
                                | Start a conversation with
                                | your AI Coach.


            // =================================================
            // ACTIVE CHAT
            // =================================================

            section.ai-chat-main

                // =============================================
                // ACTIVE CHAT HEADER
                // =============================================

                header.ai-active-chat-header

                    .ai-active-chat-user

                        .ai-chat-avatar
                            | 🤖

                        .ai-active-chat-info

                            if activeConversation

                                h2
                                    = activeConversation.title || "GymBuddy AI Coach"

                            else

                                h2
                                    | GymBuddy AI Coach


                            .ai-online-status

                                span.ai-online-dot

                                span
                                    | AI Fitness Assistant


                    .ai-chat-header-badge
                        | AI


                // =============================================
                // MESSAGES
                // =============================================

                section.ai-messages-container

                    if messages && messages.length > 0

                        each item in messages

                            if item.role === "user" || item.sender === "user"

                                .ai-message-row.ai-message-row-user

                                    .ai-message-bubble.ai-user-bubble

                                        p
                                            = item.message

                                        if item.created_at

                                            small.ai-message-time
                                                = new Date(item.created_at).toLocaleString("en-GB")


                            if item.role === "assistant" || item.sender === "assistant"

                                .ai-message-row.ai-message-row-assistant

                                    .ai-message-avatar
                                        | 🤖

                                    .ai-message-bubble.ai-assistant-bubble

                                        strong.ai-message-sender
                                            | GymBuddy AI Coach

                                        p
                                            = item.message

                                        if item.created_at

                                            small.ai-message-time
                                                = new Date(item.created_at).toLocaleString("en-GB")


                    else

                        .ai-chat-welcome

                            .ai-chat-welcome-icon
                                | 🤖

                            p.ai-welcome-eyebrow
                                | GYMBUDDY AI

                            h2
                                | What are we working on today?

                            p.ai-chat-welcome-description
                                | Ask about your training, progress,
                                | workout partners or fitness goals.


                            .ai-suggestion-grid

                                .ai-suggestion-card

                                    .ai-suggestion-icon
                                        | 🏋️

                                    div

                                        strong
                                            | Workout Advice

                                        p
                                            | Help me plan my next workout.


                                .ai-suggestion-card

                                    .ai-suggestion-icon
                                        | 🔥

                                    div

                                        strong
                                            | My Progress

                                        p
                                            | How am I doing with my training?


                                .ai-suggestion-card

                                    .ai-suggestion-icon
                                        | 🤝

                                    div

                                        strong
                                            | Partner Matches

                                        p
                                            | Explain my recommended partners.


                                .ai-suggestion-card

                                    .ai-suggestion-icon
                                        | 💪

                                    div

                                        strong
                                            | Fitness Guidance

                                        p
                                            | Help me work towards my goal.


                // =============================================
                // MESSAGE COMPOSER
                // =============================================

                footer.ai-chat-input-area

                    form.ai-chat-form(
                        method="POST"
                        action="/ai-coach"
                    )

                        if activeConversationId

                            input(
                                type="hidden"
                                name="conversation_id"
                                value=activeConversationId
                            )


                        .ai-input-wrapper

                            textarea.ai-chat-input(
                                id="message"
                                name="message"
                                placeholder="Ask your AI Coach anything..."
                                rows="1"
                                maxlength="2000"
                                required
                            )

                            button.ai-send-button(
                                type="submit"
                                aria-label="Send message"
                                title="Send message"
                            )
                                span
                                    | ➤


                    p.ai-chat-disclaimer
                        | GymBuddy AI Coach can make mistakes. For injuries or medical concerns, seek qualified professional advice.