extends layout

block content

    main.notifications-hub

        // =====================================================
        // NOTIFICATIONS HERO
        // =====================================================

        section.notifications-hero

            .notifications-hero-content

                .notifications-hero-icon
                    span 🔔

                .notifications-hero-text

                    p.notifications-eyebrow ACTIVITY CENTRE

                    h1 Notifications

                    if unreadCount === 0
                        p
                            | You're all caught up. New GymBuddy activity will appear here.

                    else if unreadCount === 1
                        p
                            | You have 1 new notification waiting for you.

                    else
                        p
                            | You have #{unreadCount} new notifications waiting for you.


            .notifications-hero-actions

                if unreadCount > 0

                    form(
                        method="POST"
                        action="/notifications/read-all"
                    )

                        button.notifications-read-all(
                            type="submit"
                        )
                            span ✓
                            |  Mark All as Read


        // =====================================================
        // NOTIFICATION SUMMARY
        // =====================================================

        section.notifications-summary

            .notification-summary-card

                .summary-icon
                    span 🔔

                .summary-content

                    span.summary-number
                        if notifications
                            = notifications.length
                        else
                            | 0

                    span.summary-label
                        | Total Notifications


            .notification-summary-card

                .summary-icon
                    span 🔵

                .summary-content

                    span.summary-number
                        if unreadCount
                            = unreadCount
                        else
                            | 0

                    span.summary-label
                        | Unread


            .notification-summary-card

                .summary-icon
                    span ✓

                .summary-content

                    span.summary-number
                        if notifications
                            - var readCount = notifications.filter(function(item) { return item.is_read; }).length
                            = readCount
                        else
                            | 0

                    span.summary-label
                        | Read


        // =====================================================
        // SECTION HEADING
        // =====================================================

        section.notifications-section-header

            .notifications-section-title

                p.notifications-eyebrow
                    | RECENT ACTIVITY

                h2 Your Notifications

                p
                    | Click a notification to open the related GymBuddy activity.


        // =====================================================
        // NOTIFICATIONS
        // =====================================================

        if notifications && notifications.length > 0

            section.notifications-feed

                each notification in notifications

                    if notification.is_read

                        article.notification-item.is-read

                            a.notification-main-link(
                                href="/notifications/" + notification.notification_id + "/open"
                                aria-label="Open notification"
                            )

                                .notification-item-icon
                                    span ✓

                                .notification-item-content

                                    .notification-item-top

                                        span.notification-badge.read
                                            | Read

                                        if notification.displayTime
                                            span.notification-time
                                                = notification.displayTime

                                    p.notification-item-message
                                        = notification.message

                                    if notification.target_url
                                        span.notification-open-hint
                                            | Open activity →


                            .notification-item-actions

                                form(
                                    method="POST"
                                    action="/notifications/" + notification.notification_id + "/delete"
                                    onsubmit="return confirm('Are you sure you want to delete this notification?')"
                                )

                                    button.notification-action-button.delete-button(
                                        type="submit"
                                    )
                                        | Delete


                    else

                        article.notification-item.is-unread

                            a.notification-main-link(
                                href="/notifications/" + notification.notification_id + "/open"
                                aria-label="Open notification"
                            )

                                .notification-item-icon
                                    span 🔔

                                .notification-item-content

                                    .notification-item-top

                                        span.notification-badge.new
                                            | New

                                        if notification.displayTime
                                            span.notification-time
                                                = notification.displayTime

                                    p.notification-item-message
                                        = notification.message

                                    if notification.target_url
                                        span.notification-open-hint
                                            | Open activity →


                            .notification-item-actions

                                form(
                                    method="POST"
                                    action="/notifications/" + notification.notification_id + "/read"
                                )

                                    button.notification-action-button.read-button(
                                        type="submit"
                                    )
                                        | ✓ Mark as Read


                                form(
                                    method="POST"
                                    action="/notifications/" + notification.notification_id + "/delete"
                                    onsubmit="return confirm('Are you sure you want to delete this notification?')"
                                )

                                    button.notification-action-button.delete-button(
                                        type="submit"
                                    )
                                        | Delete


        else

            section.notifications-empty-state

                .notifications-empty-icon
                    span 🔔

                h2 You're all caught up

                p
                    | You don't have any notifications right now.
                    | Workout requests, messages and other GymBuddy
                    | activity will appear here.

                .notifications-empty-actions

                    a.notifications-primary-button(
                        href="/workouts"
                    )
                        | Explore Workouts

                    a.notifications-secondary-button(
                        href="/recommendations"
                    )
                        | Find GymBuddies