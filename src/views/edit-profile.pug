extends layout

block content

    main.account-settings-page

        //=====================================================
        // PAGE HEADER
        //=====================================================

        .account-settings-header

            .account-settings-header-copy

                p.settings-eyebrow
                    | PROFILE SETTINGS

                h1 Edit Profile

                p
                    | Update your personal details, profile photo
                    | and fitness information.

            a.settings-back-link(
                href="/profile"
            )
                | ← Back to Profile


        //=====================================================
        // SETTINGS CARD
        //=====================================================

        section.settings-card

            form(
                method="POST"
                action="/profile/edit"
                enctype="multipart/form-data"
            )

                //=================================================
                // PROFILE PHOTO
                //=================================================

                .settings-profile-photo

                    .settings-avatar

                        if user.profile_picture

                            img(
                                src=user.profile_picture
                                alt=`${user.first_name} ${user.last_name}`
                            )

                        else

                            span
                                | 👤


                    .settings-photo-info

                        p.settings-photo-label
                            | PROFILE PHOTO

                        h2
                            | #{user.first_name} #{user.last_name}

                        p.settings-photo-help
                            | Upload a clear photo so other GymBuddy users
                            | can recognise you.

                        .settings-photo-actions

                            label.settings-upload-button(
                                for="profile_picture"
                            )
                                | Change Photo

                            span.settings-photo-formats
                                | JPG, PNG, WebP, HEIC or HEIF · Max 10MB

                        input.settings-file-input(
                            type="file"
                            id="profile_picture"
                            name="profile_picture"
                            accept="image/*,.heic,.heif"
                        )


                //=================================================
                // PERSONAL INFORMATION
                //=================================================

                .settings-divider


                .settings-section

                    .settings-section-heading

                        div

                            p.settings-section-eyebrow
                                | PERSONAL INFORMATION

                            h2 Your Details

                            p
                                | These details are used across your
                                | GymBuddy profile and activity.


                    .settings-form-grid

                        .settings-field

                            label(
                                for="first_name"
                            )
                                | First Name

                            input(
                                type="text"
                                id="first_name"
                                name="first_name"
                                value=user.first_name
                                placeholder="Enter your first name"
                                required
                            )


                        .settings-field

                            label(
                                for="last_name"
                            )
                                | Last Name

                            input(
                                type="text"
                                id="last_name"
                                name="last_name"
                                value=user.last_name
                                placeholder="Enter your last name"
                                required
                            )


                    .settings-field

                        label(
                            for="email"
                        )
                            | Email Address

                        input(
                            type="email"
                            id="email"
                            name="email"
                            value=user.email
                            readonly
                        )

                        small.settings-field-note
                            | Your GymBuddy email is linked to your account
                            | and cannot currently be changed here.


                //=================================================
                // FITNESS PROFILE
                //=================================================

                .settings-divider


                .settings-section

                    .settings-section-heading

                        div

                            p.settings-section-eyebrow
                                | FITNESS PROFILE

                            h2 Your Fitness Preferences

                            p
                                | Keep these details accurate so GymBuddy
                                | can personalise recommendations and coaching.


                    .settings-field

                        label(
                            for="fitness_goal"
                        )
                            | Primary Fitness Goal

                        select(
                            id="fitness_goal"
                            name="fitness_goal"
                            required
                        )

                            option(
                                value="lose_weight"
                                selected=user.fitness_goal === "lose_weight"
                            )
                                | Lose Weight

                            option(
                                value="build_muscle"
                                selected=user.fitness_goal === "build_muscle"
                            )
                                | Build Muscle

                            option(
                                value="improve_endurance"
                                selected=user.fitness_goal === "improve_endurance"
                            )
                                | Improve Endurance

                            option(
                                value="general_fitness"
                                selected=user.fitness_goal === "general_fitness"
                            )
                                | General Fitness


                    .settings-field

                        label(
                            for="profile_bio"
                        )
                            | Profile Bio

                        textarea(
                            id="profile_bio"
                            name="profile_bio"
                            rows="5"
                            maxlength="500"
                            placeholder="Tell other GymBuddy users about your training style, goals or experience..."
                        )= user.profile_bio || ""

                        small.settings-field-note
                            | This is visible on your profile and helps
                            | potential workout partners understand you better.


                //=================================================
                // SAVE ACTIONS
                //=================================================

                .settings-divider


                .settings-actions

                    .settings-actions-copy

                        strong
                            | Ready to update your profile?

                        span
                            | Your changes will appear on your GymBuddy profile.

                    .settings-actions-buttons

                        a.settings-cancel-button(
                            href="/profile"
                        )
                            | Cancel

                        button.settings-save-button(
                            type="submit"
                        )
                            | Save Changes