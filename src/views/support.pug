extends layout

block content
    main.support-page
        h1 Help and Support

        p Tell us what problem you are experiencing.

        form(method="POST" action="/support")
            label(for="email") Contact Email

            input(
                type="email"
                id="email"
                name="email"
                value=email
                required
            )

            label(for="issue_type") Issue Type

            select(
                id="issue_type"
                name="issue_type"
                required
            )
                option(value="") Select an issue
                option(value="Login Problem") Login Problem
                option(value="Registration Problem") Registration Problem
                option(value="Password Problem") Password Problem
                option(value="Profile Problem") Profile Problem
                option(value="Workout Creation Problem") Workout Creation Problem
                option(value="Workout Request Problem") Workout Request Problem
                option(value="Messaging Problem") Messaging Problem
                option(value="Notification Problem") Notification Problem
                option(value="Image Upload Problem") Image Upload Problem
                option(value="Account Access Problem") Account Access Problem
                option(value="Performance Problem") Performance Problem
                option(value="Bug Report") Bug Report
                option(value="Feature Request") Feature Request
                option(value="Other") Other

            label(for="message") Describe the Problem

            textarea(
                id="message"
                name="message"
                placeholder="Explain what happened, what you expected, and any error message you saw."
                required
            )

            button(type="submit") Submit Support Ticket

        a(href="/my-support-tickets") View My Tickets