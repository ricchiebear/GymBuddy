extends layout

block content

    main.help-centre-page

        // =====================================================
        // HERO
        // =====================================================

        section.help-hero

            .help-hero-content

                p.help-eyebrow
                    | GYMBUDDY SUPPORT

                h1 Help Centre

                p.help-hero-description
                    | Find quick answers about your account,
                    | workouts, messages, recommendations,
                    | notifications and GymBuddy features.


            .help-hero-icon
                | 🆘


        // =====================================================
        // HELP INTRO
        // =====================================================

        section.help-intro

            .help-intro-copy

                h2 How can we help?

                p
                    | Browse the categories below and open
                    | any question to see the answer.


            if isLoggedIn

                a.help-support-shortcut(
                    href="/support"
                )
                    | 🎧 Contact Support


        // =====================================================
        // HELP CATEGORIES
        // =====================================================

        section.help-category-grid

            // =================================================
            // ACCOUNT & LOGIN
            // =================================================

            article.help-category-card

                .help-category-heading

                    .help-category-icon
                        | 🔐

                    div

                        p.help-category-eyebrow
                            | ACCOUNT

                        h2 Account & Login


                .help-accordion

                    details.help-faq-item

                        summary
                            | I cannot log into my account

                        .help-faq-answer

                            p
                                | Make sure you are entering the email
                                | address and password associated with
                                | your GymBuddy account.

                            p
                                | GymBuddy account emails currently use
                                | the @buddy.co.uk domain.


                    details.help-faq-item

                        summary
                            | How do I create an account?

                        .help-faq-answer

                            p
                                | Select Create an Account from the
                                | GymBuddy home page and complete the
                                | registration process.


                    details.help-faq-item

                        summary
                            | How do I edit my profile?

                        .help-faq-answer

                            p
                                | Open My Profile and select Edit Profile.
                                | You can update your name, fitness goal,
                                | profile bio and profile picture.


            // =================================================
            // WORKOUTS
            // =================================================

            article.help-category-card

                .help-category-heading

                    .help-category-icon
                        | 🏋️

                    div

                        p.help-category-eyebrow
                            | TRAINING

                        h2 Workouts


                .help-accordion

                    details.help-faq-item

                        summary
                            | How do I create a workout?

                        .help-faq-answer

                            p
                                | Open the Workouts section and select
                                | Create Workout.

                            p
                                | Enter the workout type, location,
                                | start time, end time and other
                                | required information.


                    details.help-faq-item

                        summary
                            | How do I join somebody else's workout?

                        .help-faq-answer

                            p
                                | Open the workout details page and send
                                | a join request.

                            p
                                | The workout owner must accept your
                                | request before you become an accepted
                                | participant.


                    details.help-faq-item

                        summary
                            | What happens after my join request is accepted?

                        .help-faq-answer

                            p
                                | The workout is added to your Joined
                                | Workouts and you gain access to the
                                | workout group chat.


                    details.help-faq-item

                        summary
                            | What happens when a workout is cancelled?

                        .help-faq-answer

                            p
                                | When the workout owner cancels a workout,
                                | all accepted participants receive a
                                | notification.


                    details.help-faq-item

                        summary
                            | When can a workout be marked as completed?

                        .help-faq-answer

                            p
                                | Only the workout owner can mark a workout
                                | as completed.

                            p
                                | The workout can only be completed after
                                | its scheduled end time.


                    details.help-faq-item

                        summary
                            | What happens when a workout is completed?

                        .help-faq-answer

                            p
                                | The workout status becomes completed.

                            p
                                | Workout history and streak information
                                | are updated for the owner and accepted
                                | participants.


            // =================================================
            // MESSAGING
            // =================================================

            article.help-category-card

                .help-category-heading

                    .help-category-icon
                        | 💬

                    div

                        p.help-category-eyebrow
                            | COMMUNICATION

                        h2 Messaging


                .help-accordion

                    details.help-faq-item

                        summary
                            | How does private messaging work?

                        .help-faq-answer

                            p
                                | GymBuddy allows one-to-one private
                                | conversations between users.

                            p
                                | Users who are already connected through
                                | an accepted workout can communicate
                                | directly.


                    details.help-faq-item

                        summary
                            | What is a message request?

                        .help-faq-answer

                            p
                                | If you are not already connected with
                                | another user, your first message can be
                                | sent as a message request.

                            p
                                | The receiver can accept or reject the
                                | request.


                    details.help-faq-item

                        summary
                            | Who can use a workout group chat?

                        .help-faq-answer

                            p
                                | The workout owner and accepted
                                | participants can access that workout's
                                | group chat.


            // =================================================
            // RECOMMENDATIONS
            // =================================================

            article.help-category-card

                .help-category-heading

                    .help-category-icon
                        | 🤝

                    div

                        p.help-category-eyebrow
                            | MATCHING

                        h2 Partner Recommendations


                .help-accordion

                    details.help-faq-item

                        summary
                            | What is the Partner Recommendation System?

                        .help-faq-answer

                            p
                                | GymBuddy recommends users who may be
                                | compatible workout partners.


                    details.help-faq-item

                        summary
                            | How is my compatibility score calculated?

                        .help-faq-answer

                            p
                                | GymBuddy currently compares several
                                | factors including fitness goals,
                                | workout streaks, workout experience
                                | and shared workout interests.


                    details.help-faq-item

                        summary
                            | What does a higher percentage mean?

                        .help-faq-answer

                            p
                                | A higher percentage indicates that the
                                | recommendation system found more
                                | similarities between your workout
                                | information and the other user's
                                | information.


                    details.help-faq-item

                        summary
                            | Can I view a recommended user's profile?

                        .help-faq-answer

                            p
                                | Yes. Select View Profile from the
                                | recommendations page to see their
                                | public GymBuddy profile.


            // =================================================
            // NOTIFICATIONS
            // =================================================

            article.help-category-card

                .help-category-heading

                    .help-category-icon
                        | 🔔

                    div

                        p.help-category-eyebrow
                            | UPDATES

                        h2 Notifications


                .help-accordion

                    details.help-faq-item

                        summary
                            | What notifications does GymBuddy send?

                        .help-faq-answer

                            p
                                | GymBuddy may notify you about workout
                                | join requests, accepted or rejected
                                | requests, private messages, message
                                | requests, workout cancellations and
                                | workout completions.


                    details.help-faq-item

                        summary
                            | Can I mark notifications as read?

                        .help-faq-answer

                            p
                                | Yes. You can mark individual
                                | notifications as read or use
                                | Mark All as Read.


                    details.help-faq-item

                        summary
                            | Can I delete notifications?

                        .help-faq-answer

                            p
                                | Yes. Notifications can be deleted
                                | individually.


            // =================================================
            // STREAKS
            // =================================================

            article.help-category-card

                .help-category-heading

                    .help-category-icon
                        | 🔥

                    div

                        p.help-category-eyebrow
                            | PROGRESS

                        h2 Workout Streaks & History


                .help-accordion

                    details.help-faq-item

                        summary
                            | How are workout streaks updated?

                        .help-faq-answer

                            p
                                | Workout streaks update when completed
                                | workouts are recorded.

                            p
                                | Consecutive workout days increase the
                                | streak, while completing multiple
                                | workouts on the same day does not
                                | incorrectly increase it multiple times.


                    details.help-faq-item

                        summary
                            | Where does my workout history come from?

                        .help-faq-answer

                            p
                                | Completed workouts are recorded in your
                                | GymBuddy workout history.


            // =================================================
            // SAFETY & REPORTING
            // =================================================

            article.help-category-card

                .help-category-heading

                    .help-category-icon
                        | 🚩

                    div

                        p.help-category-eyebrow
                            | SAFETY

                        h2 Safety & Reporting


                .help-accordion

                    details.help-faq-item

                        summary
                            | How do I report a workout?

                        .help-faq-answer

                            p
                                | Open the relevant workout and select
                                | the report option.


                    details.help-faq-item

                        summary
                            | What types of problems can I report?

                        .help-faq-answer

                            p
                                | Reports may include spam, unsafe
                                | activity, suspicious behaviour,
                                | inappropriate workout information
                                | or other concerns.


        // =====================================================
        // SUPPORT CTA
        // =====================================================

        section.help-support-cta

            .help-support-cta-icon
                | 🎧


            .help-support-cta-content

                p.help-eyebrow
                    | STILL NEED HELP?

                h2 Talk to GymBuddy Support

                p
                    | If you couldn't find the answer you need,
                    | submit a support ticket and describe the issue.


            .help-support-cta-actions

                if isLoggedIn

                    a.primary-button(
                        href="/support"
                    )
                        | Contact Support

                    a.secondary-button(
                        href="/my-support-tickets"
                    )
                        | My Support Tickets

                else

                    a.primary-button(
                        href="/login"
                    )
                        | Login to Contact Support