extends layout

block content

    main.private-chat-app

        .private-chat-shell

            //=====================================================
            // CHAT HEADER
            //=====================================================

            header.private-chat-header

                .private-chat-header-left

                    a.private-chat-back(
                        href="/messages"
                        aria-label="Back to messages"
                    ) ←

                    .private-chat-partner-avatar

                        if partner.profile_picture

                            img(
                                src=partner.profile_picture
                                alt=`${partner.first_name} ${partner.last_name}`
                            )

                        else

                            span 👤


                    .private-chat-partner-info

                        h1
                            | #{partner.first_name} #{partner.last_name}

                        if canMessage

                            .private-chat-status

                                span.private-chat-status-dot

                                span GymBuddy conversation

                        if !canMessage

                            p.private-chat-status-text
                                | Message request required


                a.private-chat-profile-link(
                    href=`/users/${partner.user_id}`
                ) View Profile


            //=====================================================
            // NORMAL PRIVATE CHAT
            //=====================================================

            if canMessage

                section.private-message-area

                    if messages && messages.length > 0

                        each msg in messages

                            if Number(msg.sender_id) === Number(currentUserId)

                                .private-message-row.private-message-row-sent

                                    .private-message-bubble.private-message-bubble-sent

                                        p.private-message-text
                                            = msg.message

                                        if msg.displayTime

                                            small.private-message-time
                                                = msg.displayTime


                            if Number(msg.sender_id) !== Number(currentUserId)

                                .private-message-row.private-message-row-received

                                    .private-message-sender-avatar

                                        if msg.sender_profile_picture

                                            img(
                                                src=msg.sender_profile_picture
                                                alt=`${msg.sender_first_name} ${msg.sender_last_name}`
                                            )

                                        else

                                            span 👤


                                    .private-message-bubble.private-message-bubble-received

                                        strong.private-message-sender-name
                                            | #{msg.sender_first_name} #{msg.sender_last_name}

                                        p.private-message-text
                                            = msg.message

                                        if msg.displayTime

                                            small.private-message-time
                                                = msg.displayTime


                    else

                        .private-chat-empty

                            .private-chat-empty-icon
                                | 💬

                            h2 Start the conversation

                            p
                                | Send a message to #{partner.first_name}
                                | and start planning your next workout.


                footer.private-chat-composer

                    form.private-chat-form(
                        method="POST"
                        action=`/messages/${partner.user_id}`
                    )

                        textarea.private-chat-input(
                            id="message"
                            name="message"
                            placeholder=`Message ${partner.first_name}...`
                            rows="1"
                            required
                        )

                        button.private-chat-send-button(
                            type="submit"
                            aria-label="Send message"
                        )


            //=====================================================
            // NON-MESSAGEABLE STATES
            //=====================================================

            if !canMessage

                if requestStatus && requestStatus.toLowerCase() === "pending"

                    section.private-chat-state

                        .private-chat-state-icon
                            | ⏳

                        h2 Message request pending

                        p
                            | Your request to message #{partner.first_name}
                            | is still waiting for approval.

                        a.secondary-button(
                            href="/messages"
                        ) Back to Messages


                if requestStatus && requestStatus.toLowerCase() === "rejected"

                    section.private-chat-state

                        .private-chat-state-icon
                            | ❌

                        h2 Message request rejected

                        p
                            | Your previous request to message
                            | #{partner.first_name} was rejected.

                        a.secondary-button(
                            href="/messages"
                        ) Back to Messages


                if !requestStatus

                    section.private-chat-request

                        .private-chat-request-content

                            .private-chat-state-icon
                                | 👋

                            h2 Start a conversation

                            p
                                | You are not currently matched with
                                | #{partner.first_name}. Your first message
                                | will be sent as a message request.

                            form.private-message-request-form(
                                method="POST"
                                action=`/messages/${partner.user_id}`
                            )

                                label(
                                    for="message"
                                ) First Message

                                textarea(
                                    id="message"
                                    name="message"
                                    placeholder=`Introduce yourself to ${partner.first_name}...`
                                    required
                                )

                                button.primary-button(
                                    type="submit"
                                ) Send Message Request