extends layout

block content

    main.support-ticket-details-page

        - const ticketStatus = String(ticket.status || "pending").toLowerCase()
        - const ticketStatusClass = ticketStatus.replace(/\s+/g, "-").replace(/_/g, "-")
        - const submittedDate = ticket.created_at ? new Date(ticket.created_at).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }) : "Date unavailable"
        - const submittedTime = ticket.created_at ? new Date(ticket.created_at).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" }) : ""


        // =====================================================
        // BACK NAVIGATION
        // =====================================================

        .support-ticket-back-row

            a.support-ticket-back-link(
                href="/my-support-tickets"
            )

                span
                    | ←

                |  Back to Support Tickets


        // =====================================================
        // TICKET HERO
        // =====================================================

        section.support-ticket-details-hero

            .support-ticket-details-hero-content

                .support-ticket-details-icon
                    | 🎫

                .support-ticket-details-heading

                    p.support-ticket-eyebrow
                        | SUPPORT CASE

                    h1
                        | Ticket ##{ticket.ticket_id}

                    p
                        | View the details and current status
                        | of your support request.


            span.support-ticket-status(
                class=`support-status-${ticketStatusClass}`
            )

                if ticketStatus === "resolved"

                    | ✓ Resolved

                else if ticketStatus === "closed"

                    | ✓ Closed

                else if ticketStatus === "open"

                    | ● Open

                else if ticketStatus === "pending"

                    | ● Pending

                else if ticketStatus === "in progress" || ticketStatus === "in_progress"

                    | ● In Progress

                else

                    | ● #{ticket.status || "Pending"}


        // =====================================================
        // TICKET OVERVIEW
        // =====================================================

        section.support-ticket-overview


            // =================================================
            // ISSUE TYPE
            // =================================================

            article.support-ticket-info-card

                .support-ticket-info-icon
                    | 🛠️

                .support-ticket-info-content

                    span.support-ticket-info-label
                        | ISSUE TYPE

                    strong
                        = ticket.issue_type || "General Support"


            // =================================================
            // CONTACT EMAIL
            // =================================================

            article.support-ticket-info-card

                .support-ticket-info-icon
                    | ✉️

                .support-ticket-info-content

                    span.support-ticket-info-label
                        | CONTACT EMAIL

                    strong.support-ticket-email
                        = ticket.email || "Not provided"


            // =================================================
            // SUBMITTED DATE
            // =================================================

            article.support-ticket-info-card

                .support-ticket-info-icon
                    | 📅

                .support-ticket-info-content

                    span.support-ticket-info-label
                        | SUBMITTED

                    strong
                        = submittedDate

                    if submittedTime

                        small
                            = submittedTime


        // =====================================================
        // MAIN CONTENT
        // =====================================================

        section.support-ticket-details-layout


            // =================================================
            // PROBLEM DESCRIPTION
            // =================================================

            article.support-ticket-message-card

                .support-ticket-message-heading

                    .support-ticket-message-heading-left

                        .support-ticket-message-icon
                            | 💬

                        div

                            p.support-ticket-eyebrow
                                | YOUR REQUEST

                            h2
                                | Problem Description


                .support-ticket-message-body

                    if ticket.message

                        p
                            = ticket.message

                    else

                        p
                            | No problem description was provided.


            // =================================================
            // TICKET PROGRESS
            // =================================================

            aside.support-ticket-progress-card

                .support-ticket-progress-heading

                    .support-ticket-progress-icon
                        | 🎧

                    div

                        p.support-ticket-eyebrow
                            | SUPPORT

                        h2
                            | Ticket Progress


                .support-ticket-timeline


                    // =========================================
                    // TICKET SUBMITTED
                    // =========================================

                    .support-ticket-timeline-item.is-complete

                        .support-ticket-timeline-marker
                            | ✓

                        .support-ticket-timeline-content

                            strong
                                | Ticket submitted

                            span
                                | Your support request was received.


                    // =========================================
                    // CURRENT STATUS
                    // =========================================

                    if ticketStatus === "resolved"

                        .support-ticket-timeline-item.is-complete

                            .support-ticket-timeline-marker
                                | ✓

                            .support-ticket-timeline-content

                                strong
                                    | Resolved

                                span
                                    | Your support request has been resolved.


                    else if ticketStatus === "closed"

                        .support-ticket-timeline-item.is-complete

                            .support-ticket-timeline-marker
                                | ✓

                            .support-ticket-timeline-content

                                strong
                                    | Closed

                                span
                                    | This support case has been closed.


                    else if ticketStatus === "in progress" || ticketStatus === "in_progress"

                        .support-ticket-timeline-item.is-current

                            .support-ticket-timeline-marker
                                | •

                            .support-ticket-timeline-content

                                strong
                                    | In Progress

                                span
                                    | Your support request is currently being reviewed.


                    else if ticketStatus === "pending"

                        .support-ticket-timeline-item.is-current

                            .support-ticket-timeline-marker
                                | •

                            .support-ticket-timeline-content

                                strong
                                    | Pending Review

                                span
                                    | Your support request is waiting to be reviewed.


                    else

                        .support-ticket-timeline-item.is-current

                            .support-ticket-timeline-marker
                                | •

                            .support-ticket-timeline-content

                                strong
                                    | Open

                                span
                                    | Your support request is open and awaiting review.


        // =====================================================
        // HELP / ACTION BAR
        // =====================================================

        section.support-ticket-action-bar

            .support-ticket-action-copy

                .support-ticket-action-icon
                    | 💡

                div

                    strong
                        | Need help with something else?

                    p
                        | Create another support ticket and tell
                        | us what's going on.


            a.support-ticket-new-button(
                href="/support"
            )
                | + New Support Ticket