extends layout

block content

    main.joined-workouts-page

        // =====================================================
        // PAGE HEADER
        // =====================================================

        section.joined-workouts-hero

            .joined-workouts-hero-copy

                p.joined-workouts-eyebrow
                    | YOUR TRAINING SESSIONS

                h1 My Joined Workouts

                p
                    | Keep track of the workouts you've joined,
                    | check session details and stay connected
                    | with your training partners.


            .joined-workouts-summary

                .joined-workouts-summary-icon
                    | 🏋️

                div

                    small
                        | Joined Workouts

                    strong
                        if workouts
                            = workouts.length
                        else
                            | 0


        // =====================================================
        // WORKOUT LIST
        // =====================================================

        if workouts && workouts.length > 0

            section.joined-workouts-grid

                each workout in workouts

                    article.joined-workout-card

                        // =========================================
                        // IMAGE
                        // =========================================

                        .joined-workout-image

                            if workout.workout_image

                                img(
                                    src=workout.workout_image
                                    alt=workout.title
                                )

                            else

                                .joined-workout-image-placeholder
                                    | 🏋️


                            if workout.status

                                span.joined-workout-status(
                                    class=`joined-workout-status-${String(workout.status).toLowerCase()}`
                                )
                                    = workout.status


                        // =========================================
                        // CONTENT
                        // =========================================

                        .joined-workout-content

                            .joined-workout-top

                                .joined-workout-type
                                    | #{workout.workout_type || "Workout"}

                                .joined-workout-host
                                    | Hosted by #{workout.creator_first_name} #{workout.creator_last_name}


                            h2
                                = workout.title


                            // =====================================
                            // WORKOUT DETAILS
                            // =====================================

                            .joined-workout-details

                                .joined-workout-detail

                                    span
                                        | 📍

                                    div

                                        small
                                            | Location

                                        strong
                                            = workout.location || "Not set"


                                .joined-workout-detail

                                    span
                                        | 🕒

                                    div

                                        small
                                            | Starts

                                        if workout.start_time

                                            strong
                                                = new Date(workout.start_time).toLocaleString("en-GB")

                                        else

                                            strong
                                                | Not available


                                .joined-workout-detail

                                    span
                                        | ⏱️

                                    div

                                        small
                                            | Ends

                                        if workout.end_time

                                            strong
                                                = new Date(workout.end_time).toLocaleString("en-GB")

                                        else

                                            strong
                                                | Not available


                            // =====================================
                            // ACTIONS
                            // =====================================

                            .joined-workout-actions

                                a.joined-workout-view(
                                    href=`/workouts/${workout.workout_id}`
                                )
                                    | View Details


                                a.joined-workout-chat(
                                    href=`/workouts/${workout.workout_id}/chat`
                                )
                                    | 💬 Group Chat


                                form(
                                    method="POST"
                                    action=`/joined-workouts/${workout.workout_id}/leave`
                                    onsubmit="return confirm('Are you sure you want to leave this workout?')"
                                )

                                    button.joined-workout-leave(
                                        type="submit"
                                    )
                                        | Leave Workout


        else

            section.joined-workouts-empty

                .joined-workouts-empty-icon
                    | 🏋️

                h2 No joined workouts yet

                p
                    | You haven't joined any workouts yet.
                    | Explore available sessions and find one
                    | that fits your goals and schedule.

                a.primary-button(
                    href="/workouts"
                )
                    | Explore Workouts