extends layout 

block content 
    h1 Workout Join Requests 

    if requests.length === 0
        p You have no pending workout join requests at the moment. Check back later!
    else
        each request in requests
            div
                h3= request.title 
                p Requested by: #{request.requester.first_name} #{request.requester.last_name}
                p Status: #{request.status}

                form(method="POST" action=`/workout-requests/${request.request_id}/accept`)
                    button(type="submit") Accept
                form(method="POST" action=`/workout-requests/${request.request_id}/reject`)
                    button(type="submit") Reject