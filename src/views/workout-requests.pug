extends layout

block content
    h1 Workout Join Requests

    if requests && requests.length > 0
        each request in requests
            .request-card
                h3= request.title

                p
                    strong Requested by:
                    |  #{request.first_name} #{request.last_name}

                p
                    strong Status:
                    |  #{request.status}

                p
                    strong Requested on:
                    |  #{new Date(request.created_at).toLocaleString()}

                .request-actions
                    form(
                        method="POST"
                        action=`/workout-requests/${request.request_id}/accept`
                    )
                        button(type="submit") Accept

                    form(
                        method="POST"
                        action=`/workout-requests/${request.request_id}/reject`
                    )
                        button(type="submit") Reject
    else
        p You have no pending workout join requests at the moment. Check back later, Buddy!