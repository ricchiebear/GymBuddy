extends layout

block content
    main.workout-chat-page
        h1 Workout Group Chat

        if workout
            h2= workout.title

        form(
            method="POST"
            action=`/workouts/${workout.workout_id}/chat`
        )
            label(for="message") Message

            textarea(
                id="message"
                name="message"
                placeholder="Type your message..."
                required
            )

            button(type="submit") Send

        h2 Messages

        #messages
            if !messages || messages.length === 0
                p No messages yet. Start the conversation.
            else
                each msg in messages
                    article.chat-message(
                        class=Number(msg.sender_id) === Number(currentUserId) ? "sent-message" : "received-message"
                    )
                        .message-sender
                            if msg.profile_picture
                                img(
                                    src=msg.profile_picture
                                    alt=`${msg.first_name} ${msg.last_name}`
                                    width="40"
                                    height="40"
                                )
                            else
                                span.sender-avatar 👤

                            strong
                                | #{msg.first_name} #{msg.last_name}

                        p.message-text= msg.message

                        small.message-time= msg.displayTime

        br

        a(
            href=`/workouts/${workout.workout_id}`
        ) ← Back to Workout